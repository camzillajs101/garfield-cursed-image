<%= form_with model: @image, url: "/" do |f| %>
  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name, placeholder: "Title of the image" %>
  </div>

  <div class="field">
    <%= f.label :path %><br>
    <%= f.text_field :path, placeholder: "Name of the image file" %>
  </div>

  <div class="field">
    <%= f.check_box :nsfw %>
    <%= f.label :nsfw %>
  </div>

  <div class="actions">
    <%= f.submit "Add image" %>
  </div>
<% end %>
